// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum CaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CaseSeverity {
  CRITICAL    // Changements majeurs avec fort impact
  WARNING     // Changements significatifs à surveiller
  STABLE      // Alternatives stables et fiables
}

enum NotificationType {
  REPLY           // Quelqu'un répond à votre post/commentaire
  MENTION         // Quelqu'un vous mentionne @username
  UPVOTE          // Votre post/commentaire reçoit un upvote
  REACTION        // Quelqu'un réagit à votre post
  BADGE_UNLOCKED  // Vous débloquez un nouveau badge
  CASE_APPROVED   // Votre cas signalé est approuvé
  CASE_REJECTED   // Votre cas signalé est rejeté
  CASE_UPDATED    // Un cas que vous avez signalé est mis à jour
  POST_PINNED     // Votre post a été épinglé
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(MEMBER)
  organization String?
  
  // Gamification
  reputation Int      @default(0)  // Points de réputation
  badges     String   @default("") // JSON string containing array of badges
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  cases     Case[]
  posts     Post[]
  comments  Comment[]
  postVotes PostVote[]
  commentVotes CommentVote[]
  reactions PostReaction[]
  notifications Notification[]
  
  @@map("users")
}

model Case {
  id                String        @id @default(cuid())
  companyName       String
  productName       String
  category          String
  licenseInitial    String
  licenseFinal      String
  changeDate        String
  website           String
  description       String
  legalAnalysis     String
  communityReaction String
  sources           String        // JSON string containing array of sources
  alternatives      String?       // JSON string containing array of alternatives
  status            CaseStatus    @default(PENDING)
  severity          CaseSeverity  @default(WARNING) // Niveau de gravité du changement
  reportCount       Int           @default(1) // Nombre de fois que le cas a été signalé
  
  // Reporter info
  reporterId        String
  reporter          User        @relation(fields: [reporterId], references: [id])
  
  // Metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@map("cases")
}

// Forum Models
model Post {
  id          String      @id @default(cuid())
  title       String
  content     String      // Markdown content
  category    String
  tags        String      @default("") // JSON array of tags
  
  // Author
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  
  // Moderation
  isPinned    Boolean     @default(false)
  
  // Engagement
  views       Int         @default(0)
  upvotes     Int         @default(0)
  downvotes   Int         @default(0)
  
  // Relations
  comments    Comment[]
  votes       PostVote[]
  reactions   PostReaction[]
  
  // Metadata
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@map("posts")
}

model Comment {
  id          String         @id @default(cuid())
  content     String
  
  // Author
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  
  // Post relation
  postId      String
  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Parent comment (for nested replies)
  parentId    String?
  parent      Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]      @relation("CommentReplies")
  
  // Engagement
  upvotes     Int            @default(0)
  downvotes   Int            @default(0)
  
  // Relations
  votes       CommentVote[]
  
  // Metadata
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@map("comments")
}

model PostVote {
  id        String   @id @default(cuid())
  value     Int      // 1 for upvote, -1 for downvote
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, postId])
  @@map("post_votes")
}

model CommentVote {
  id        String   @id @default(cuid())
  value     Int      // 1 for upvote, -1 for downvote
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, commentId])
  @@map("comment_votes")
}

// Emoji reactions on posts
model PostReaction {
  id        String   @id @default(cuid())
  emoji     String   // 👍 👎 🔥 ❤️ 😂 😮 😢 😡
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, postId, emoji])
  @@map("post_reactions")
}

// Notifications system
model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  link        String?          // URL vers la ressource concernée
  isRead      Boolean          @default(false)
  
  // Metadata optionnelle (JSON pour flexibilité)
  metadata    String?          // JSON: {postId, commentId, authorName, etc.}
  
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime         @default(now())
  
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// License Monitoring System
model WatchedRepository {
  id          String   @id @default(cuid())
  owner       String   // GitHub owner/org
  name        String   // Repository name
  platform    String   @default("github") // github, gitlab, etc.
  url         String   // Full URL to repo
  
  // Monitoring config
  isActive    Boolean  @default(true)
  priority    String   @default("medium") // high, medium, low
  lastChecked DateTime?
  
  // Current state
  currentLicense String?
  stars       Int?
  description String?
  
  // Metadata
  addedBy     String?
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  changes     LicenseChange[]
  
  @@unique([platform, owner, name])
  @@index([isActive, lastChecked])
  @@map("watched_repositories")
}

model LicenseChange {
  id              String   @id @default(cuid())
  
  // Repository info
  repoId          String
  repository      WatchedRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  
  // Change details
  oldLicense      String?
  newLicense      String?
  changeType      String   // "added", "modified", "removed", "restrictive", "permissive"
  severity        CaseSeverity @default(WARNING)
  
  // Detection info
  detectedAt      DateTime @default(now())
  detectionMethod String   // "commit_analysis", "api_check", "manual", "external_source"
  commitSha       String?
  commitUrl       String?
  commitDate      DateTime?
  commitAuthor    String?
  
  // Status
  status          String   @default("detected") // detected, reviewed, approved, rejected, case_created
  reviewedAt      DateTime?
  reviewedBy      String?
  
  // Auto-generated case
  caseId          String?  // Link to Case if created
  
  // Additional data
  confidence      Float    @default(1.0) // 0-1 confidence score
  sources         String?  // JSON array of source URLs
  notes           String?
  metadata        String?  // JSON for additional data
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status, severity])
  @@index([detectedAt])
  @@index([repoId, detectedAt])
  @@map("license_changes")
}

model MonitoringLog {
  id              String   @id @default(cuid())
  
  // What was monitored
  targetType      String   // "repository", "package", "rss", "api"
  targetId        String?  // ID of watched repo or external identifier
  targetName      String
  
  // Result
  status          String   // "success", "error", "no_change"
  changesFound    Int      @default(0)
  errorMessage    String?
  
  // Performance
  duration        Int?     // milliseconds
  
  // Metadata
  executedAt      DateTime @default(now())
  metadata        String?  // JSON for additional data
  
  @@index([executedAt])
  @@index([targetType, status])
  @@map("monitoring_logs")
}

